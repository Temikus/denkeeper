{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "reviewers": [
    "Temikus"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Track indirect Go modules (off by default) so vulnerability alerts cover them; routine bumps wait for dashboard approval",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true,
      "dependencyDashboardApproval": true
    }
  ]
}
